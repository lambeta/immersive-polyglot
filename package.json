{
  "name": "immersive-polyglot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Immersive web translator using user-supplied LLM providers",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "verify:rendering": "node scripts/verify-rendering.mjs",
    "verify:styles": "node scripts/verify-styles.mjs",
    "make:icons": "node scripts/make-icons.mjs",
    "test:e2e:local": "PLAYWRIGHT_BROWSERS_PATH=$PWD/.playwright-browsers playwright test",
    "dev:provider": "node scripts/dev-provider.mjs",
    "verify:real-provider": "node scripts/verify-real-provider.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "typecheck:plugin": "tsc -p tsconfig.plugin.json",
    "test:plugin": "vitest run tests/unit/plugin tests/dom/plugin",
    "check:plugin": "npm run typecheck:plugin && npm run test:plugin && npm run build:plugin && node scripts/check-client-jsx.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.2",
    "@playwright/test": "1.48.2",
    "@types/chrome": "0.0.287",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.9.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "jsdom": "25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
