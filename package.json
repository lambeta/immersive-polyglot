{
  "name": "immersive-polyglot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Immersive web translator using user-supplied LLM providers",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "verify:rendering": "node scripts/verify-rendering.mjs",
    "verify:styles": "node scripts/verify-styles.mjs",
    "test:e2e:local": "PLAYWRIGHT_BROWSERS_PATH=$PWD/.playwright-browsers playwright test",
    "dev:provider": "node scripts/dev-provider.mjs",
    "verify:real-provider": "node scripts/verify-real-provider.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/chrome": "0.0.287",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.9.0",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
